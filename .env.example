# PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iwms

# JWT signing secrets (required, 32+ characters, different from each other).
# The API refuses to start without them. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Redis (optional for worker queue)
REDIS_URL=redis://localhost:6379
